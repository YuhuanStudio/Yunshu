{
  "name": "yunshu-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3971 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts && vitest run vitest/",
    "preview": "vite preview --host 127.0.0.1 --port 3971 --strictPort",
    "test:browser": "playwright test",
    "format": "prettier --write src tests browser *.ts *.json index.html"
  },
  "dependencies": {
    "@yuhuanowo/yunui": "file:vendor/yuhuanowo-yunui-0.2.18-analytics.tgz",
    "katex": "0.18.1",
    "lucide-react": "1.28.0",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18"
  }
}
