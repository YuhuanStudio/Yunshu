# Model paths for scripts/release/gate.sh (and the research scripts). Copy the lines you
# need into scripts/research/local.env (gitignored) and point them at your own checkouts.
# A family whose variable is unset is reported as SKIP, not PASS.

# Tier 1 (required by the serve-27b and soak stages)
M=~/models/Jundot/Qwen3.8-27B-oQ4e-mtp

# Families stage
M_QWEN35_08B=~/models/Qwen3.5-0.8B-MLX-bf16
M_QWEN35_9B=~/models/Qwen3.5-9B-MLX-4bit
M_TEXT_LM=~/models/Qwen2.5-3B-Instruct-4bit
M_GEMMA=~/models/gemma-4-e4b-it-bf16
M_OCR=~/models/GLM-OCR-bf16
M_ASR=~/models/Qwen3-ASR-1.7B-bf16
M_TTS=~/models/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16
M_OMNI=~/models/Qwen3-Omni-30B-A3B-Instruct-4bit
M_IMAGE=~/models/Z-Image-Turbo-MLX-4bit

# Where the gate builds, installs and keeps its own HOME (default below)
# GATE_ROOT=/path/with/space/yunshu-build/gate
# GATE_MODELS_DIR=~/models        # the models dir the installed CLI is pointed at
# PULL_REPO=Jundot/Qwen3.8-27B-oQ4e-mtp   # must already exist under GATE_MODELS_DIR

# Research / dev scripts
# GPUQ_DIR=~/.cache/yunshu/gpuq          # gpuq state dir (read by scripts/dev/gpuq)
# YUNSHU_PY=~/yunshu/.venv/bin/python    # interpreter for the research session scripts
# YUNSHU_ANE_PY=~/venvs/ane/bin/python   # venv with coremltools (ANE probes)
# YUNSHU_ANE_WORK=~/.cache/yunshu/ane    # compiled ANE packages
# SDK_VENV=~/venvs/sdk                   # venv with the openai/anthropic/ollama SDKs
# YUNSHU_TEST_MODELS=~/models            # models dir for the real-model tests/scripts
# YUNSHU_CN_JSONL=~/data/train_CN.jsonl  # CN corpus for scripts/research/accuracy
# YUNSHU_ACCURACY_CACHE=~/.cache/yunshu/accuracy
