#!/usr/bin/env python3
"""CPU preflight followed by concurrent, SHA-pinned release verification.

--dry-run prints the plan without running CI, creating trees or submitting jobs.
Agentbench is submitted at lower priority and collected separately; it never blocks tagging.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
RELEASE_ROOT = Path("/Volumes/P5Plus/yunshu-build/release-check")
REUSABLE = ("gate", "m3sweep", "agentcompat")
# Paths that cannot change what the gate / M3 sweep / agentcompat exercise: prose and the unit
# tests (ci-local reruns those on every commit). User 2026-11-10: a docs edit after a passing
# gate must not rerun the 2-hour GPU checks.
NON_RUNTIME = re.compile(r"^(docs/|tests/|\.github/)|\.md$")


def code_identity(sha: str, repo: Path = REPO) -> str:
    """Hash of the commit's tree without the NON_RUNTIME paths: two commits with the same identity
    serve, install and test-drive the same code."""
    import hashlib

    listing = subprocess.check_output(
        ["git", "-C", str(repo), "ls-tree", "-r", "--full-tree", sha], text=True
    )
    kept = [
        ln
        for ln in listing.splitlines()
        if "\t" in ln and not NON_RUNTIME.search(ln.split("\t", 1)[1])
    ]
    return hashlib.sha256("\n".join(kept).encode()).hexdigest()[:24]


def reusable_passes(
    identity: str, sha: str, root: Path = RELEASE_ROOT, repo: Path = REPO
) -> dict:
    """{check: row} of blocking checks that passed on an earlier commit with the same code identity."""
    found: dict = {}
    for vp in sorted(root.glob("*/verdict.json"), key=lambda p: p.stat().st_mtime):
        try:
            v = json.loads(vp.read_text())
        except (OSError, ValueError):
            continue
        other = v.get("commit", "")
        if not other or other == sha:
            continue
        ident = v.get("code_identity")
        if ident is None:
            try:
                ident = code_identity(other, repo)
            except subprocess.CalledProcessError:
                continue
        if ident != identity:
            continue
        for name in REUSABLE:
            row = (v.get("checks") or {}).get(name) or {}
            if row.get("status") == "PASS":
                found[name] = {
                    "status": "PASS",
                    "evidence": row.get("evidence", ""),
                    "reused_from": other,
                }
    return found


def plan(sha, tree, out, prefix, priority=2):
    """The blocking checks run at ``priority`` (default 2: a release is cut every few days and its
    gate must not wait behind research jobs - 2026-11-10 the -1 gate sat 2 h behind p0/p1 work);
    agentbench stays informational at -3."""
    dev = tree / "scripts/dev"
    pr = str(priority)
    return {
        "gate": [str(dev / "yv"), "gate", "--priority", pr],
        "m3sweep": [
            str(dev / "m3sweep"),
            sha,
            "--priority",
            pr,
            "--label-prefix",
            prefix + "-m3",
        ],
        "agentcompat": [
            str(dev / "agentcompat"),
            "--out",
            str(out / "agentcompat"),
            "--priority",
            pr,
            "--label-prefix",
            prefix + "-compat",
        ],
        "agentbench": [
            str(dev / "agentbench"),
            "--ref",
            sha,
            "--priority",
            "-3",
            "--label-prefix",
            prefix + "-bench",
            "--no-wait",
        ],
    }


def judge(rc, path):
    try:
        v = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return "FAIL"
    if not isinstance(v, dict):
        return "FAIL"
    verdict = v.get("overall", v.get("verdict"))
    passed = verdict == "PASS" if verdict is not None else v.get("ok") is True
    return "PASS" if rc == 0 and passed else "FAIL"


def checklist(rows):
    print("\nRelease checklist")
    for name in ("ci-local", "gate", "m3sweep", "agentcompat", "agentbench"):
        r = rows[name]
        print(
            f"- [{'x' if r['status'] == 'PASS' else ' '}] {name}: {r['status']} {r.get('evidence', '')}"
            + (
                f" (reused from {r['reused_from'][:12]})"
                if r.get("reused_from")
                else ""
            )
            + (" (non-blocking)" if name == "agentbench" else "")
        )


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("ref", nargs="?", default="main")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument(
        "--priority", type=int, default=2, help="gpuq priority of the blocking checks"
    )
    ap.add_argument(
        "--no-reuse",
        action="store_true",
        help="rerun the GPU checks even when an earlier commit with the same runtime code passed them",
    )
    ap.add_argument("--label-prefix", default="releng015-release")
    ap.add_argument("--out", type=Path)
    a = ap.parse_args(argv)
    sha = subprocess.check_output(
        ["git", "-C", str(REPO), "rev-parse", a.ref + "^{commit}"], text=True
    ).strip()
    out = a.out or Path("/Volumes/P5Plus/yunshu-build/release-check") / sha
    tree = out / "src"
    commands = plan(
        sha, tree, out, f"{a.label_prefix}-{time.time_ns()}", priority=a.priority
    )
    rows = {
        n: {"status": "PLANNED" if a.dry_run else "NOT_RUN"}
        for n in ("ci-local", *commands)
    }
    print(f"Release commit: {sha}", flush=True)
    identity = code_identity(sha)
    reused = (
        {} if a.no_reuse or a.dry_run else reusable_passes(identity, sha, out.parent)
    )
    for name, row in reused.items():
        commands.pop(name, None)
        rows[name] = row
        print(
            f"{name}: reused PASS of {row['reused_from'][:12]} (same runtime code {identity})"
        )
    if a.dry_run:
        print(
            shlex.join(
                [
                    str(REPO / "scripts/dev/gpuq"),
                    "run",
                    "--gate",
                    "--",
                    "nice",
                    "-n",
                    "15",
                    str(REPO / "scripts/dev/ci-local"),
                    sha,
                ]
            )
        )
        for name, cmd in commands.items():
            print(f"{name}: {shlex.join(cmd)}")
        checklist(rows)
        return 0
    out.mkdir(parents=True, exist_ok=True)
    ci_log = out / "ci-local.log"
    with ci_log.open("w") as log:
        # through gpuq: the unit suite uses the GPU and must not overlap a timing job
        rc = subprocess.run(
            [
                str(REPO / "scripts/dev/gpuq"),
                "run",
                "--label",
                f"{a.label_prefix}-ci-local",
                "--priority",
                str(a.priority),  # 2026-11-10: at p0 it waited 20 min behind p1 suites
                "--gate",
                "--timeout",
                "90",
                "--mem-gb",
                "16",
                "--",
                "nice",
                "-n",
                "15",
                str(REPO / "scripts/dev/ci-local"),
                sha,
            ],
            stdout=log,
            stderr=subprocess.STDOUT,
        ).returncode
    rows["ci-local"] = {
        "status": "PASS" if rc == 0 else "FAIL",
        "evidence": str(ci_log),
    }
    if rc == 0:
        if not tree.exists():
            subprocess.run(
                ["git", "clone", "-q", "--no-hardlinks", str(REPO), str(tree)],
                check=True,
            )
        subprocess.run(
            ["git", "-C", str(tree), "checkout", "-q", "--detach", sha], check=True
        )
        env = dict(
            os.environ,
            GPUQ_OWNER=os.environ.get("GPUQ_OWNER", a.label_prefix),
            YV_LABEL_PREFIX=a.label_prefix,
            GPUQ_DIR=os.environ.get("GPUQ_DIR", "/Volumes/P5Plus/yunshu-gpuq"),
            YV_GPUQ="/Users/yuhuan/Documents/YuhuanStudio/Yunshu/scripts/dev/gpuq",
            YV_ROOT=str(out / "verify"),
        )
        processes = {}
        # Launch every verifier before waiting for any one of them.
        for name, cmd in commands.items():
            log = (out / f"{name}.log").open("w")
            try:
                proc = subprocess.Popen(
                    ["nice", "-n", "15", *cmd],
                    cwd=tree,
                    env=env,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                )
            except OSError as error:
                log.write(str(error) + "\n")
                log.close()
                rows[name] = {"status": "FAIL", "evidence": str(out / f"{name}.log")}
                continue
            processes[name] = (proc, log)
        for name, (proc, log) in processes.items():
            rc = proc.wait()
            log.close()
            content = (out / f"{name}.log").read_text()
            if name == "gate":
                vp = out / "verify/runs" / f"gate-{sha[:12]}" / "verdict.json"
            elif name == "agentcompat":
                vp = out / "agentcompat/verdict.json"
            else:
                matches = re.findall(r"(/[^\s()]+/verdict\.json)", content)
                vp = Path(matches[-1]) if matches else None
            if name == "agentbench" and rc == 0:
                collect = re.findall(
                    r"collect later: agentbench --collect (\S+)", content
                )
                rows[name] = {
                    "status": "PENDING" if collect else "FAIL",
                    "evidence": f"agentbench --collect {collect[-1]}"
                    if collect
                    else str(out / f"{name}.log"),
                }
            else:
                rows[name] = {
                    "status": judge(rc, vp) if vp else "FAIL",
                    "evidence": str(vp or out / f"{name}.log"),
                }
    checklist(rows)
    success = all(rows[n]["status"] == "PASS" for n in rows if n != "agentbench")
    (out / "verdict.json").write_text(
        json.dumps(
            {
                "commit": sha,
                "code_identity": identity,
                "overall": "PASS" if success else "FAIL",
                "checks": rows,
            },
            indent=2,
        )
        + "\n"
    )
    return 0 if success else 1


if __name__ == "__main__":
    raise SystemExit(main())
