#!/usr/bin/env python3
"""CPU preflight followed by concurrent, SHA-pinned release verification.

--dry-run prints the plan without running CI, creating trees or submitting jobs.
Agentbench is submitted at lower priority and collected separately; it never blocks tagging.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]


def plan(sha, tree, out, prefix):
    dev = tree / "scripts/dev"
    return {
        "gate": [str(dev / "yv"), "gate", "--priority", "-1"],
        "m3sweep": [
            str(dev / "m3sweep"),
            sha,
            "--priority",
            "-1",
            "--label-prefix",
            prefix + "-m3",
        ],
        "agentcompat": [
            str(dev / "agentcompat"),
            "--out",
            str(out / "agentcompat"),
            "--priority",
            "-1",
            "--label-prefix",
            prefix + "-compat",
        ],
        "agentbench": [
            str(dev / "agentbench"),
            "--ref",
            sha,
            "--priority",
            "-3",
            "--label-prefix",
            prefix + "-bench",
            "--no-wait",
        ],
    }


def judge(rc, path):
    try:
        v = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return "FAIL"
    if not isinstance(v, dict):
        return "FAIL"
    verdict = v.get("overall", v.get("verdict"))
    passed = verdict == "PASS" if verdict is not None else v.get("ok") is True
    return "PASS" if rc == 0 and passed else "FAIL"


def checklist(rows):
    print("\nRelease checklist")
    for name in ("ci-local", "gate", "m3sweep", "agentcompat", "agentbench"):
        r = rows[name]
        print(
            f"- [{'x' if r['status'] == 'PASS' else ' '}] {name}: {r['status']} {r.get('evidence', '')}"
            + (" (non-blocking)" if name == "agentbench" else "")
        )


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("ref", nargs="?", default="main")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--label-prefix", default="releng015-release")
    ap.add_argument("--out", type=Path)
    a = ap.parse_args(argv)
    sha = subprocess.check_output(
        ["git", "-C", str(REPO), "rev-parse", a.ref + "^{commit}"], text=True
    ).strip()
    out = a.out or Path("/Volumes/P5Plus/yunshu-build/release-check") / sha
    tree = out / "src"
    commands = plan(sha, tree, out, f"{a.label_prefix}-{time.time_ns()}")
    rows = {
        n: {"status": "PLANNED" if a.dry_run else "NOT_RUN"}
        for n in ("ci-local", *commands)
    }
    print(f"Release commit: {sha}", flush=True)
    if a.dry_run:
        print(shlex.join(["nice", "-n", "15", str(REPO / "scripts/dev/ci-local"), sha]))
        for name, cmd in commands.items():
            print(f"{name}: {shlex.join(cmd)}")
        checklist(rows)
        return 0
    out.mkdir(parents=True, exist_ok=True)
    ci_log = out / "ci-local.log"
    with ci_log.open("w") as log:
        rc = subprocess.run(
            ["nice", "-n", "15", str(REPO / "scripts/dev/ci-local"), sha],
            stdout=log,
            stderr=subprocess.STDOUT,
        ).returncode
    rows["ci-local"] = {
        "status": "PASS" if rc == 0 else "FAIL",
        "evidence": str(ci_log),
    }
    if rc == 0:
        if not tree.exists():
            subprocess.run(
                ["git", "clone", "-q", "--no-hardlinks", str(REPO), str(tree)],
                check=True,
            )
        subprocess.run(
            ["git", "-C", str(tree), "checkout", "-q", "--detach", sha], check=True
        )
        env = dict(
            os.environ,
            GPUQ_OWNER=os.environ.get("GPUQ_OWNER", a.label_prefix),
            YV_LABEL_PREFIX=a.label_prefix,
            GPUQ_DIR=os.environ.get("GPUQ_DIR", "/Volumes/P5Plus/yunshu-gpuq"),
            YV_GPUQ="/Users/yuhuan/Documents/YuhuanStudio/Yunshu/scripts/dev/gpuq",
            YV_ROOT=str(out / "verify"),
        )
        processes = {}
        # Launch every verifier before waiting for any one of them.
        for name, cmd in commands.items():
            log = (out / f"{name}.log").open("w")
            try:
                proc = subprocess.Popen(
                    ["nice", "-n", "15", *cmd],
                    cwd=tree,
                    env=env,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                )
            except OSError as error:
                log.write(str(error) + "\n")
                log.close()
                rows[name] = {"status": "FAIL", "evidence": str(out / f"{name}.log")}
                continue
            processes[name] = (proc, log)
        for name, (proc, log) in processes.items():
            rc = proc.wait()
            log.close()
            content = (out / f"{name}.log").read_text()
            if name == "gate":
                vp = out / "verify/runs" / f"gate-{sha[:12]}" / "verdict.json"
            elif name == "agentcompat":
                vp = out / "agentcompat/verdict.json"
            else:
                matches = re.findall(r"(/[^\s()]+/verdict\.json)", content)
                vp = Path(matches[-1]) if matches else None
            if name == "agentbench" and rc == 0:
                collect = re.findall(
                    r"collect later: agentbench --collect (\S+)", content
                )
                rows[name] = {
                    "status": "PENDING" if collect else "FAIL",
                    "evidence": f"agentbench --collect {collect[-1]}"
                    if collect
                    else str(out / f"{name}.log"),
                }
            else:
                rows[name] = {
                    "status": judge(rc, vp) if vp else "FAIL",
                    "evidence": str(vp or out / f"{name}.log"),
                }
    checklist(rows)
    success = all(rows[n]["status"] == "PASS" for n in rows if n != "agentbench")
    (out / "verdict.json").write_text(
        json.dumps(
            {"commit": sha, "overall": "PASS" if success else "FAIL", "checks": rows},
            indent=2,
        )
        + "\n"
    )
    return 0 if success else 1


if __name__ == "__main__":
    raise SystemExit(main())
