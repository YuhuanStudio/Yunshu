#!/bin/sh
# Run the release workflow's build-and-check job locally before tagging (CPU only, no GPU).
#   scripts/dev/ci-local [REF]      # REF defaults to HEAD
#   YUNSHU_CI_BROWSER=1 scripts/dev/ci-local [REF]  # also run Chromium + WebKit
# Mirrors .github/workflows/release.yml: a fresh checkout of REF, `uv sync --dev --extra vision
# --extra compression` into its own venv, ruff/mypy, console checks, the unit suite, uv build, twine and a wheel
# install smoke. The suite runs under sandbox-exec with this machine's build volume and the main
# checkout unreadable, as on the CI runner, so tests that depend on local paths fail here first.
set -eu
# The unit suite runs MLX on the GPU: outside gpuq it overlapped timing jobs and voided them
# (2026-11-02: a turn-2 probe read 10x slow while ci-local ran beside it). Inside a gpuq job
# GPUQ_RC is set; YUNSHU_CI_OUTSIDE_GPUQ=1 overrides on a machine with no timing work.
# YUNSHU_CI_STAGE splits the run (default all): `cpu` = lint, mypy, console checks, the browser suite (vite and a
# stand-in engine), the build and the wheel smoke - no GPU, allowed outside gpuq; `gpu` = the unit suite, inside gpuq. 2026-11-10: the ~50 min browser suite held the GPU lane while 25 jobs waited.
STAGE="${YUNSHU_CI_STAGE:-all}"
case "$STAGE" in all|cpu|gpu) ;; *) echo "ci-local: YUNSHU_CI_STAGE must be all, cpu or gpu" >&2; exit 2;; esac
if [ "$STAGE" != cpu ] && [ -z "${GPUQ_RC:-}" ] && [ "${YUNSHU_CI_OUTSIDE_GPUQ:-0}" != 1 ]; then
  echo "ci-local: run it through gpuq (scripts/dev/gpuq submit --label ci-local -- scripts/dev/ci-local [REF]);" >&2
  echo "          its unit suite uses the GPU. YUNSHU_CI_OUTSIDE_GPUQ=1 runs it here anyway." >&2
  exit 2
fi
# The CI runner has no gpuq job context: the job's GPUQ_* variables would turn research harness
# tests onto their gpuq branches, so they are dropped for the suite.
for v in $(env | sed -n 's/^\(GPUQ_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
REF="${1:-HEAD}"
SRC="$(cd "$(dirname "$0")/../.." && pwd)"
SHA="$(git -C "$SRC" rev-parse "$REF")"
# Short path on purpose: AF_UNIX socket paths cap at 104 bytes on macOS and the runner's TMPDIR is short.
# YUNSHU_CI_ROOT moves the ~8 GB checkout + venv off the system disk (an external SSD; it must not be
# the denied build volume below). Default /tmp.
WORK="${YUNSHU_CI_ROOT:-/tmp}/ycl-$(echo "$SHA" | cut -c1-8)"
[ "$STAGE" = all ] || WORK="$WORK-$STAGE"  # the two halves run at the same time
[ -d "$WORK" ] && chmod -R u+w "$WORK" 2>/dev/null; rm -rf "$WORK"  # tests leave read-only harness snapshots
# A failing run's checkout stays for debugging, but only until the next run: three kept failures filled the system
# disk (36 GB) on 2026-10-25. Older than 6 h so a concurrent run's checkout is never touched.
find "${YUNSHU_CI_ROOT:-/tmp}/" -maxdepth 1 -type d -name 'ycl-*' -mmin +360 -exec chmod -R u+w {} + -exec rm -rf {} + 2>/dev/null || echo "ci-local: could not remove every old checkout (continuing)"
git clone -q --no-hardlinks "$SRC" "$WORK"
git -C "$WORK" checkout -q "$SHA"
cd "$WORK"
TAG="$(git describe --tags --exact-match 2>/dev/null || true)"
if [ -n "$TAG" ]; then
  grep -q "^## \[${TAG#v}\]" CHANGELOG.md || { echo "ci-local: CHANGELOG has no [${TAG#v}] section"; exit 1; }
fi
uv python install 3.13 >/dev/null
UV_PROJECT_ENVIRONMENT="$WORK/.venv" uv sync -q --python 3.13 --dev --extra vision --extra compression
uv run --python 3.13 ruff check python/ tests/
uv run --python 3.13 ruff format --check python/ tests/
uv run --python 3.13 python scripts/dev/mypy_gate.py
if [ "$STAGE" != gpu ]; then
(cd frontend && pnpm install --frozen-lockfile && pnpm exec tsc --noEmit && pnpm test && pnpm build && pnpm exec yunui doctor --strict && pnpm exec yunui audit --strict)
fi
if [ "$STAGE" != gpu ] && [ "${YUNSHU_CI_BROWSER:-0}" = 1 ]; then
  # A port nothing answers on (the resident console and agent servers live in 18990-18999); Playwright never reuses a server
  # already on the port (playwright.config.ts), so a taken port fails loudly.
  PW_PORT=$("$WORK/.venv/bin/python" -c 'import socket; s=socket.socket(); s.bind(("0.0.0.0", 0)); print(s.getsockname()[1])')
  (cd frontend && pnpm exec playwright install --with-deps chromium webkit && \
    PLAYWRIGHT_PORT="$PW_PORT" YUNSHU_TEST_PYTHON="$WORK/.venv/bin/python" pnpm test:browser)
fi
# The unit suite is the only part that uses the GPU: the cpu stage skips it and goes on to the build and the
# wheel checks (they need the console bundle the frontend build above produced); the gpu stage stops after it.
if [ "$STAGE" != cpu ]; then
PROFILE="$WORK/ci.sb"
cat > "$PROFILE" <<EOF
(version 1)
(allow default)
(deny file-read* file-write* (subpath "/Volumes/P5Plus"))
(deny file-read* file-write* (subpath "$SRC"))
; setuid binaries (ps) cannot exec inside any sandbox profile; the runner has them, so run them unsandboxed.
(allow process-exec* (with no-sandbox) (literal "/bin/ps"))
EOF
# HOME is a throwaway dir too: the runner has no ~/.yunshu, model caches or agent configs.
CIHOME="$WORK/home"
mkdir -p "$CIHOME"
mkdir -p "$CIHOME/tmp" "$CIHOME/shim"
# The sandbox answers EPERM where the runner answers ENOENT (the paths do not exist there), and
# Python 3.13's Path.exists() raises on EPERM. Report ENOENT for the denied roots, as on the runner.
cat > "$CIHOME/shim/sitecustomize.py" <<PYEOF
import os, sys
_deny = ("/Volumes/P5Plus", "$SRC")
_stat, _lstat = os.stat, os.lstat
def _wrap(fn):
    def inner(path, *a, **k):
        try:
            return fn(path, *a, **k)
        except PermissionError:
            if isinstance(path, (str, bytes, os.PathLike)) and os.fspath(path) and str(os.fspath(path)).startswith(_deny):
                raise FileNotFoundError(2, "No such file or directory", os.fspath(path)) from None
            raise
    return inner
# Only 3.13+ raises on EPERM in Path.exists(); older interpreters (system python3 in the tool
# tests' subprocesses) bind os.stat as a pathlib accessor method, which a Python wrapper breaks.
if sys.version_info >= (3, 13):
    os.stat, os.lstat = _wrap(_stat), _wrap(_lstat)
PYEOF
# The sandboxed suite writes its output inside $WORK: if the caller redirected stdout to a denied
# path (e.g. a log on /Volumes/P5Plus), every write would fail and pytest would exit 120 silently.
# The plain and the paravirtual suite are independent, so they run at the same time with their own
# HOME and TMPDIR; the paravirtual pass exercises runner capability
# fallbacks even on a physical Apple GPU (tests that pin physical hardware keep their override).
# Each suite spreads its tests over YUNSHU_CI_WORKERS pytest-xdist workers, one test file per worker at a
# time (--dist loadfile: the fault harness shares engine state within a file). Most tests wait on sockets, subprocesses or timers rather than the CPU, so
# 2 x 12 workers fit on 18 cores (one suite ~9 min on one process -> ~1 min). Tests marked `serial` read
# host-wide state (CPU load, process table) and run alone afterwards.
W="${YUNSHU_CI_WORKERS:-12}"
PVHOME="$WORK/home-pv"
cp -R "$CIHOME" "$PVHOME"
plain_env() { sandbox-exec -f "$PROFILE" env -u YV_PY -u YV_ROOT -u YUNSHU_MAIN -u VIRTUAL_ENV PYTHONPATH="$CIHOME/shim" TMPDIR="$CIHOME/tmp" HOME="$CIHOME" "$@"; }
para_env() { sandbox-exec -f "$PROFILE" env -u YV_PY -u YV_ROOT -u YUNSHU_MAIN -u VIRTUAL_ENV PYTHONPATH="$PVHOME/shim:$WORK" TMPDIR="$PVHOME/tmp" HOME="$PVHOME" "$@"; }
set +e
plain_env "$WORK/.venv/bin/python" -m pytest tests/unit -q --tb=short -p no:cacheprovider --timeout=600 --timeout-method=thread ${CI_PYTEST_ARGS:-} -n "$W" --dist loadfile -m "not serial and not fullcmp_e2e" --durations=25 > "$WORK/pytest.log" 2>&1 &
plain=$!
para_env "$WORK/.venv/bin/python" -m pytest tests/unit -q --tb=short -p no:cacheprovider --timeout=600 --timeout-method=thread ${CI_PYTEST_ARGS:-} -n "$W" --dist loadfile -m "not serial and not fullcmp_e2e" -p scripts.dev.ci_paravirtual > "$WORK/pytest-paravirtual.log" 2>&1 &
para=$!
# The suites write into $WORK, so the caller's log would stay silent for the whole run and gpuq stops a job
# whose log does not grow for 10 min ("stalled"; 1108f was killed after both suites passed in 10.5 min).
# Print one progress line a minute until both suites exit.
( while kill -0 "$plain" 2>/dev/null || kill -0 "$para" 2>/dev/null; do
    sleep 60; echo "ci-local: pytest running ($(wc -c < "$WORK/pytest.log" 2>/dev/null || echo 0) + $(wc -c < "$WORK/pytest-paravirtual.log" 2>/dev/null || echo 0) bytes of output)"
  done ) &
beat=$!
wait "$plain"
rc=$?
wait "$para"
prc=$?
kill "$beat" 2>/dev/null; wait "$beat" 2>/dev/null
# Exit 5 = no test carries the marker.
plain_env "$WORK/.venv/bin/python" -m pytest tests/unit -q --tb=short -p no:cacheprovider --timeout=600 --timeout-method=thread -m serial >> "$WORK/pytest.log" 2>&1
s=$?; [ "$s" -eq 0 ] || [ "$s" -eq 5 ] || [ "$rc" -ne 0 ] || rc=$s
para_env "$WORK/.venv/bin/python" -m pytest tests/unit -q --tb=short -p no:cacheprovider --timeout=600 --timeout-method=thread -m serial -p scripts.dev.ci_paravirtual >> "$WORK/pytest-paravirtual.log" 2>&1
s=$?; [ "$s" -eq 0 ] || [ "$s" -eq 5 ] || [ "$prc" -ne 0 ] || prc=$s
set -e
cat "$WORK/pytest.log"
# A skipped test did not run: the count must not rise above the committed baseline (scripts/dev/ci_skip_baseline.json).
skiprc=0
"$WORK/.venv/bin/python" scripts/dev/ci_skips.py plain "$WORK/pytest.log" || skiprc=1
"$WORK/.venv/bin/python" scripts/dev/ci_skips.py paravirtual "$WORK/pytest-paravirtual.log" || skiprc=1
[ "$rc" -eq 0 ] || { echo "ci-local: FAIL (pytest rc $rc) $SHA"; exit "$rc"; }
cat "$WORK/pytest-paravirtual.log"
[ "$prc" -eq 0 ] || { echo "ci-local: FAIL (paravirtual pytest rc $prc) $SHA"; exit "$prc"; }
[ "$skiprc" -eq 0 ] || { echo "ci-local: FAIL (skipped tests above the baseline) $SHA"; exit 1; }
fi
if [ "$STAGE" = gpu ]; then
  cd /
  [ "${YUNSHU_CI_KEEP:-0}" = 1 ] || { chmod -R u+w "$WORK" 2>/dev/null; rm -rf "$WORK"; }
  echo "ci-local: GPU stage PASS $SHA"
  exit 0
fi
uv build -q
"$WORK/.venv/bin/python" - <<'PYCODE'
import glob, tarfile, zipfile
with zipfile.ZipFile(glob.glob("dist/*.whl")[0]) as wheel:
    assert "yunshu_gateway/console_static/index.html" in wheel.namelist()
with tarfile.open(glob.glob("dist/*.tar.gz")[0]) as source:
    assert any(name.endswith("python/yunshu_gateway/console_static/index.html") for name in source.getnames())
PYCODE
uvx -q twine check dist/*
UV_TOOL_DIR="$WORK/tools" UV_TOOL_BIN_DIR="$WORK/bin" uv tool install --python 3.13 "$(ls dist/yunshu-*.whl)"
"$WORK/bin/yunshu" --version
# A passing run's ~13 GB checkout + venv is not needed again (a failing one stays for debugging);
# YUNSHU_CI_KEEP=1 keeps it.
cd /
[ "${YUNSHU_CI_KEEP:-0}" = 1 ] || { chmod -R u+w "$WORK" 2>/dev/null; rm -rf "$WORK"; }
echo "ci-local: PASS $SHA ($WORK$([ "${YUNSHU_CI_KEEP:-0}" = 1 ] || echo ', removed'))"
