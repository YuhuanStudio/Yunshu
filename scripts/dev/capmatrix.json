  {
   "id": "json_schema",
   "group": "structured",
   "api": "POST /v1/chat/completions",
   "desc": "strict json_schema output has the required keys",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Describe Paris as JSON."
     }
    ],
    "response_format": {
     "type": "json_schema",
     "json_schema": {
      "name": "city",
      "strict": true,
      "schema": {
       "type": "object",
       "properties": {
        "city": {
         "type": "string"
        },
        "country": {
         "type": "string"
        },
        "is_capital": {
         "type": "boolean"
        }
       },
       "required": [
        "city",
        "country",
        "is_capital"
       ],
       "additionalProperties": false
      }
     }
    },
    "max_tokens": 400,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.message.content",
     "op": "json_has_keys",
     "value": [
      "city",
      "country",
      "is_capital"
     ]
    }
   ],
   "think": false
  },
