  {
   "id": "tool_parallel",
   "group": "tools",
   "api": "POST /v1/chat/completions",
   "desc": "two independent lookups yield two tool calls",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
