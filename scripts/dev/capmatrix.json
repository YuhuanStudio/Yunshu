  {
   "id": "tool_result_roundtrip",
   "group": "tools",
   "api": "POST /v1/chat/completions",
   "desc": "tool result message is used in the answer",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "What is the weather in Paris right now? Use the tool."
     },
     {
      "role": "assistant",
      "content": null,
      "tool_calls": [
       {
        "id": "call_1",
        "type": "function",
        "function": {
         "name": "get_weather",
         "arguments": "{\"city\": \"Paris\"}"
        }
       }
      ]
     },
     {
      "role": "tool",
      "tool_call_id": "call_1",
      "content": "{\"temp_c\": 17, \"sky\": \"drizzle\"}"
     }
    ],
    "tools": [
     {
      "type": "function",
      "function": {
       "name": "get_weather",
       "description": "Get the current weather for a city.",
       "parameters": {
        "type": "object",
        "properties": {
         "city": {
          "type": "string"
         }
        },
        "required": [
         "city"
        ]
       }
      }
     }
    ],
    "max_tokens": 120,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.message.content",
     "op": "contains",
     "value": "17"
    }
   ],
   "think": false
  },
