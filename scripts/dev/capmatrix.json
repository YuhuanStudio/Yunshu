  {
   "id": "regex_constraint",
   "group": "structured",
   "api": "POST /v1/chat/completions",
   "desc": "guided_regex constrains the output (vLLM/Yunshu extension)",
   "applies": [
    "yunshu"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Give a US ZIP code."
     }
    ],
    "guided_regex": "[0-9]{5}",
    "max_tokens": 20,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.message.content",
     "op": "regex",
     "value": "[0-9]{5}"
