{
 "version": 1,
 "description": "Yunshu capability matrix: one row per capability; see scripts/dev/capmatrix.py.",
 "engines": [
  "yunshu",
  "llamacpp",
  "mlxlm",
  "omlx",
  "splash"
 ],
 "features": [
  "vision",
  "audio",
  "embeddings",
  "thinking"
 ],
 "rows": [
  {
   "id": "chat_basic",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "plain completion, usage and finish_reason",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Reply with only the word ORCHID."
     }
    ],
    "max_tokens": 16,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.message.content",
     "op": "contains",
     "value": "orchid"
    },
    {
     "path": "choices.0.finish_reason",
     "op": "eq",
     "value": "stop"
    },
    {
     "path": "usage.completion_tokens",
     "op": "gte",
     "value": 1
    },
    {
     "path": "usage.prompt_tokens",
     "op": "gte",
     "value": 1
    }
   ],
   "think": false
  },
  {
   "id": "system_multiturn",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "system prompt and multi-turn history are honoured",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "system",
      "content": "You answer with one word."
     },
     {
      "role": "user",
      "content": "My name is Zelda. Remember it."
     },
     {
      "role": "assistant",
      "content": "Noted."
     },
     {
      "role": "user",
      "content": "What is my name?"
     }
    ],
    "max_tokens": 16,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.message.content",
     "op": "contains",
     "value": "zelda"
    }
   ],
   "think": false
  },
  {
   "id": "max_tokens_length",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "max_tokens ends with finish_reason length",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Write a long story about a dragon."
     }
    ],
    "max_tokens": 5,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.finish_reason",
     "op": "eq",
     "value": "length"
    },
    {
     "path": "usage.completion_tokens",
     "op": "lte",
     "value": 5
    }
   ],
   "think": false
  },
  {
   "id": "stop_sequence",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "stop string is honoured and excluded",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Count from 1 to 9 separated by single spaces."
     }
    ],
    "max_tokens": 60,
    "temperature": 0,
    "stop": [
     "5"
    ]
   },
   "asserts": [
    {
     "path": "choices.0.message.content",
     "op": "not_contains",
     "value": "5"
    },
    {
     "path": "choices.0.message.content",
     "op": "contains",
     "value": "4"
    },
    {
     "path": "choices.0.finish_reason",
     "op": "eq",
     "value": "stop"
    }
   ],
   "think": false
  },
  {
   "id": "n_choices",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "n=2 returns two choices",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Name a color."
     }
    ],
    "max_tokens": 8,
    "n": 2,
    "temperature": 0.8
   },
   "asserts": [
    {
     "path": "choices",
     "op": "len_eq",
     "value": 2
    }
   ],
   "think": false
  },
  {
   "id": "seed_determinism",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "same seed, same sampled text",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "script": "seed"
  },
  {
   "id": "logprobs",
   "group": "core",
   "api": "POST /v1/chat/completions",
   "desc": "logprobs with top_logprobs",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Reply with only the word ORCHID."
     }
    ],
    "max_tokens": 4,
    "temperature": 0,
    "logprobs": true,
    "top_logprobs": 3
   },
   "asserts": [
    {
     "path": "choices.0.logprobs.content",
     "op": "len_gte",
     "value": 1
    },
    {
     "path": "choices.0.logprobs.content.0.top_logprobs",
     "op": "len_gte",
     "value": 3
    },
    {
     "path": "choices.0.logprobs.content.0.logprob",
     "op": "lte",
     "value": 0
    }
   ],
   "think": false
  },
  {
   "id": "stream_basic",
   "group": "stream",
   "api": "POST /v1/chat/completions",
   "desc": "SSE stream ends with finish_reason and [DONE]",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Reply with only the word ORCHID."
     }
    ],
    "max_tokens": 16,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "done",
     "op": "eq",
     "value": true
    },
    {
     "path": "text",
     "op": "contains",
     "value": "orchid"
    },
    {
     "path": "finish_reason",
     "op": "eq",
     "value": "stop"
    }
   ],
   "think": false,
   "stream": "openai"
  },
  {
   "id": "stream_usage",
   "group": "stream",
   "api": "POST /v1/chat/completions",
   "desc": "stream_options.include_usage gives a final usage chunk with empty choices",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "Reply with only the word ORCHID."
     }
    ],
    "max_tokens": 16,
    "temperature": 0,
    "stream_options": {
     "include_usage": true
    }
   },
   "asserts": [
    {
     "path": "usage.total_tokens",
     "op": "gte",
     "value": 2
    },
    {
     "path": "usage_chunk_no_choices",
     "op": "eq",
     "value": true
    }
   ],
   "think": false,
   "stream": "openai"
  },
  {
   "id": "cancel_midstream",
   "group": "stream",
   "api": "POST /v1/chat/completions",
   "desc": "client disconnect mid-stream frees the server for the next request",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "script": "cancel"
  },
  {
   "id": "tool_auto",
   "group": "tools",
   "api": "POST /v1/chat/completions",
   "desc": "tool_choice auto calls the tool",
   "applies": [
    "yunshu",
    "llamacpp",
    "mlxlm",
    "omlx",
    "splash"
   ],
   "path": "/v1/chat/completions",
   "body": {
    "messages": [
     {
      "role": "user",
      "content": "What is the weather in Paris right now? Use the tool."
     }
    ],
    "tools": [
     {
      "type": "function",
      "function": {
       "name": "get_weather",
       "description": "Get the current weather for a city.",
       "parameters": {
        "type": "object",
        "properties": {
         "city": {
          "type": "string"
         }
        },
        "required": [
         "city"
        ]
       }
      }
     }
    ],
    "tool_choice": "auto",
    "max_tokens": 200,
    "temperature": 0
   },
   "asserts": [
    {
     "path": "choices.0.finish_reason",
     "op": "eq",
     "value": "tool_calls"
    },
    {
     "path": "choices.0.message.tool_calls.0.function.name",
     "op": "eq",
     "value": "get_weather"
    },
    {
     "path": "choices.0.message.tool_calls.0.function.arguments",
     "op": "json_arg_nonempty",
     "value": "city"
    }
   ],
   "think": false
  },
  {
