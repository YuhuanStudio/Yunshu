    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "shots": "node tests/shots.mjs"
  },
  "dependencies": {
    "@yuhuanowo/yunui": "file:../../frontend/vendor/yuhuanowo-yunui-0.2.18-analytics.tgz",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.18" }
