{
  "name": "yunshu-research-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private read-only live view of docs/research (not shipped).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3991 --strictPort",
    "build": "tsc --noEmit && vite build",
